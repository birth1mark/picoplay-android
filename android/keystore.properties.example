# PicoPlay Android Signing Keystore Configuration Example
# Copy this file to 'keystore.properties' in this directory and replace placeholders.
# DO NOT COMMIT keystore.properties OR ANY *.jks / *.keystore FILES!

storeFile=keystore/picoplay-release.jks
storePassword=your_keystore_password_here
keyAlias=picoplay
keyPassword=your_key_password_here
